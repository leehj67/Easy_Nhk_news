# NHK Easy Japanese Reader - PostgreSQL 연결 설정
# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
# python-dotenv 설치 시 자동 로드됨. 미설치 시 환경변수로 직접 설정.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nhk_easy_reader
DB_USER=your_username
DB_PASSWORD=your_password

# 모바일/외부 접속: run_mobile.py (Cloudflare Tunnel 사용)
# cloudflared 설치 필요 - winget install cloudflare.cloudflared

# 동적 URL 모드 (재기동 시 앱이 새 주소 자동 인식, APK 재빌드 불필요)
# apk_build/URL_REGISTRY.txt 에 Gist raw URL 설정 후 아래 추가
# GITHUB_TOKEN=ghp_xxxx
# GIST_ID=abc123

# 네이버 오픈API (선택) — 사전 검색: 백과(encyc) + Papago 일→한
# https://developers.naver.com/ → 애플리케이션 → 사용 API: 검색, Papago 번역
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 개인화 피드 AI (선택) — 미설정 시 규칙 기반 문장 + Google 번역 폴백
# GEMINI_API_KEY=   (또는 GOOGLE_API_KEY)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# 선택 REST: pip install fastapi uvicorn 후
#   uvicorn feed_server:app --host 127.0.0.1 --port 8787
